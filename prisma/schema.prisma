// Prisma schema for the Africa Drug Discovery Database (v1).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL is configured in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum ActivityLabel {
  ACTIVE
  INACTIVE
  INCONCLUSIVE
}

enum SourceType {
  LITERATURE
  DATABASE
  LAB_DEPOSIT
  OTHER
}

model Compound {
  id           String   @id @default(cuid())
  /// Stable public code used for imports and linking assays (e.g. "ADD-0001").
  code         String   @unique
  name         String
  smiles       String?
  inchikey     String?
  formula      String?
  /// African country or region the compound was sourced from (e.g. "Kenya", "West Africa").
  sourceRegion String
  sourceNotes  String?
  /// Disease tags, e.g. ["malaria", "tuberculosis"].
  diseaseTags  String[]
  createdAt    DateTime @default(now())

  // Provenance / licensing
  sourceType     SourceType?
  sourceName     String?
  sourceUrl      String?
  doi            String?
  citation       String?
  license        String?
  sourceRecordId String?

  // Origin & ABS (Nagoya Protocol / access-and-benefit-sharing)
  countryOfOrigin String?
  collectionDate  DateTime?
  absPermitRef    String?

  /// True for fictional demo/seed rows; real curated data should be false.
  isExample Boolean @default(false)

  assays Assay[]

  @@index([name])
  @@index([sourceRegion])
  @@index([isExample])
  @@index([countryOfOrigin])
}

model Assay {
  id                 String        @id @default(cuid())
  compoundId         String
  compound           Compound      @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  assayType          String
  target             String?
  organism           String?
  resultValue        Float?
  resultUnit         String?
  /// Measurement kind, e.g. IC50, EC50, MIC, Ki, % inhibition.
  measurementType    String?
  /// Qualifier for the measured value: =, <, >.
  relation           String?
  activityLabel      ActivityLabel
  reference          String?
  performedInCountry String?
  createdAt          DateTime      @default(now())

  // Provenance / licensing
  sourceType     SourceType?
  sourceName     String?
  sourceUrl      String?
  doi            String?
  citation       String?
  license        String?
  sourceRecordId String?

  /// True for fictional demo/seed rows; real curated data should be false.
  isExample Boolean @default(false)

  @@index([compoundId])
  @@index([activityLabel])
  @@index([assayType])
  @@index([isExample])
  @@index([sourceRecordId])
}
