# Copy this file to .env and adjust as needed.
# Matches the Postgres service in docker-compose.yml for local development.
# For production (e.g. Vercel + Neon), set DATABASE_URL in your hosting provider's
# environment variables instead of committing it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/africa_drug_db?schema=public"

# Admin area (/admin). Leave unset to disable it ("Admin is not configured").
# ADMIN_PASSWORD="use-a-long-random-string"
# Optional: separate session signing secret (otherwise derived from ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET=""
